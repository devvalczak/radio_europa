{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis module manifest, contract v1",
  "type": "object",
  "required": ["contract", "id", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "maxLength": 300 },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["push.send", "hub.call"] }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "sizes", "default"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "sizes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["1x1", "2x1", "2x2"] }
          },
          "default": { "enum": ["1x1", "2x1", "2x2"] },
          "refresh": { "type": "integer", "minimum": 0, "maximum": 86400 }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 },
          "confirm": { "type": "boolean" }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emits": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" } },
        "subscribes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+\\.[a-z][a-z0-9_]+$" } }
      }
    }
  }
}
