# Copy to .env and fill in (`make init` does it for you, generating the secrets).

# Session signing key, >= 32 chars. Changing it logs everybody out.
JARVIS_SECRET_KEY=
# One-time token required on first run to create the owner account.
JARVIS_SETUP_TOKEN=
# true when served over https (Cloudflare). Set false only for plain http://localhost testing.
JARVIS_COOKIE_SECURE=true

# Encrypts stored credentials (mail account passwords). Losing it means re-entering those passwords.
# Existing install without it: `make encryption-key`. Several comma-separated keys = rotation (first encrypts).
JARVIS_ENCRYPTION_KEY=
# Allow mail servers on private/LAN addresses (default false: SSRF guard).
JARVIS_ALLOW_PRIVATE_HOSTS=false

# Web Push (VAPID) keys for phone notifications — generated by `make init`.
JARVIS_VAPID_PUBLIC_KEY=
JARVIS_VAPID_PRIVATE_KEY=
JARVIS_VAPID_SUBJECT=mailto:you@example.com

# AI (optional; news digests need it). Leave empty to run without AI.
#   provider anthropic -> JARVIS_AI_MODEL=<model id>, JARVIS_AI_API_KEY=<key>
#   provider openai    -> any OpenAI-compatible API; for local Ollama set JARVIS_AI_BASE_URL=http://host.docker.internal:11434/v1
#                         (no key needed) and JARVIS_AI_MODEL=<small model, e.g. a ~1-3B one for an 8 GB laptop>
JARVIS_AI_PROVIDER=
JARVIS_AI_MODEL=
JARVIS_AI_API_KEY=
JARVIS_AI_BASE_URL=

# Shopping module (EMMA scraper). Defaults are fine; set the delivery URL if the slot is shown on another page.
# JARVIS_EMMA_BASE_URL=https://emmamarket.pl
# JARVIS_EMMA_DELIVERY_URL=

# Host port bound on 127.0.0.1
JARVIS_PORT=8080

# Only for `make up-tunnel` (named Cloudflare tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
